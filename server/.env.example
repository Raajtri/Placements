DATABASE_URL="postgresql://agi_admin:agi_dev_password@127.0.0.1:5433/agi_placement?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="change-this-access-secret-in-production"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
CLIENT_ORIGIN="http://localhost:5173"
# Set to "none" only if the frontend is deployed on a different domain than this API
# (e.g. frontend on Vercel, API on Railway). Requires HTTPS. Leave as "lax" for the
# default single-service deploy where both are served from the same origin.
COOKIE_SAMESITE="lax"
UPLOAD_DIR="../uploads"
