generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core identity & access control
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  TPO
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?

  student           Student?
  staffProfile      StaffProfile?
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  notifications     Notification[]
  auditLogsActed    AuditLog[]            @relation("AuditActor")

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Staff (Admin / TPO) profile info — accounts are provisioned by seed/admin only.
model StaffProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  designation String
  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id])
  phone       String?
  photoUrl    String?
  isPublicTeamMember Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Institute {
  id      String @id @default(cuid())
  name    String @unique
  code    String @unique
  address String?
  email   String?
  phone   String?

  programs   Program[]
  students   Student[]
  staff      StaffProfile[]
  drives     DriveEligibility[]
}

model Program {
  id          String   @id @default(cuid())
  name        String
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  departments Department[]
  students    Student[]

  @@unique([instituteId, name])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  students  Student[]

  @@unique([programId, name])
}

// ---------------------------------------------------------------------------
// Student
// ---------------------------------------------------------------------------

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model Student {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String
  enrollmentNo   String   @unique
  dob            DateTime?
  gender         String?
  phone          String?
  address        String?

  instituteId    String
  institute      Institute @relation(fields: [instituteId], references: [id])
  programId      String
  program        Program   @relation(fields: [programId], references: [id])
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  batch          String
  semester       Int?
  graduationYear Int

  cgpa           Float?
  tenthPercent   Float?
  twelfthPercent Float?
  diplomaPercent Float?
  backlogs       Int      @default(0)

  resumeUrl      String?
  skills         String[] @default([])
  certifications String[] @default([])
  projects       String?
  internships    String?
  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?
  profileCompletionPercent Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    Document[]
  applications Application[]

  @@index([instituteId, programId, departmentId, batch])
  @@index([verificationStatus])
}

enum DocumentType {
  RESUME
  PHOTOGRAPH
  ID_PROOF
  TENTH_MARKSHEET
  TWELFTH_MARKSHEET
  SEMESTER_MARKSHEET
  GRADUATION_CERTIFICATE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

model Document {
  id         String         @id @default(cuid())
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileName   String
  storedPath String
  mimeType   String
  sizeBytes  Int
  status     DocumentStatus @default(UPLOADED)
  reviewedById String?
  reviewNote String?
  uploadedAt DateTime       @default(now())
  reviewedAt DateTime?

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Companies / Corporate partners
// ---------------------------------------------------------------------------

model Company {
  id            String   @id @default(cuid())
  name          String   @unique
  logoUrl       String?
  industry      String?
  website       String?
  description   String?
  createdAt     DateTime @default(now())

  drives        Drive[]
  testimonials  IndustryTestimonial[]
}

// ---------------------------------------------------------------------------
// Placement drives
// ---------------------------------------------------------------------------

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum DriveStatus {
  UPCOMING
  OPEN
  CLOSED
  COMPLETED
}

model Drive {
  id              String      @id @default(cuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id])
  jobRole         String
  packageMin      Float?
  packageMax      Float?
  location        String?
  workMode        WorkMode    @default(ONSITE)

  minCgpa         Float?
  maxBacklogs     Int?

  applicationStart DateTime
  applicationEnd   DateTime
  driveDate        DateTime?

  jobDescription   String
  requiredSkills   String[]  @default([])
  requiredDocuments DocumentType[] @default([])
  selectionProcess String?

  status          DriveStatus @default(UPCOMING)
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  eligibility     DriveEligibility[]
  rounds          SelectionRound[]
  applications    Application[]

  @@index([status])
}

// Eligibility scoping: which institutes/programs/departments/batches may apply
model DriveEligibility {
  id           String     @id @default(cuid())
  driveId      String
  drive        Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade)
  instituteId  String
  institute    Institute  @relation(fields: [instituteId], references: [id])
  programId    String?
  departmentId String?
  batch        String?

  @@index([driveId])
}

model SelectionRound {
  id        String   @id @default(cuid())
  driveId   String
  drive     Drive    @relation(fields: [driveId], references: [id], onDelete: Cascade)
  name      String
  sequence  Int
  scheduledAt DateTime?

  @@index([driveId])
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  APTITUDE_TEST
  TECHNICAL_ROUND
  HR_ROUND
  SELECTED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

model Application {
  id         String            @id @default(cuid())
  studentId  String
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  driveId    String
  drive      Drive             @relation(fields: [driveId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(APPLIED)
  appliedAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  history    ApplicationStatusHistory[]

  @@unique([studentId, driveId])
  @@index([driveId, status])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String?
  changedById   String?
  changedAt     DateTime          @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Announcements & Notifications
// ---------------------------------------------------------------------------

enum AnnouncementCategory {
  PLACEMENT_DRIVE
  INTERNSHIP
  TRAINING
  WORKSHOP
  RECRUITMENT
  GENERAL
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  description String
  category    AnnouncementCategory @default(GENERAL)
  priority    AnnouncementPriority @default(NORMAL)
  instituteId String?
  programId   String?
  attachmentUrl String?
  status      String               @default("PUBLISHED")
  createdById String?
  createdAt   DateTime             @default(now())

  @@index([category])
}

enum NotificationType {
  DRIVE_PUBLISHED
  DEADLINE_REMINDER
  SHORTLISTED
  INTERVIEW_SCHEDULED
  RESULT
  ANNOUNCEMENT
  DOCUMENT_STATUS
  ACCOUNT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// Statistics, reports, policy content, testimonials, team
// ---------------------------------------------------------------------------

model PlacementStatistic {
  id               String  @id @default(cuid())
  academicYear     String
  instituteId      String?
  programId        String?
  departmentId     String?
  studentsPlaced   Int     @default(0)
  totalOffers      Int     @default(0)
  recruiterCount   Int     @default(0)
  highestPackage   Float?
  averagePackage   Float?
  medianPackage    Float?
  eligibleStudents Int     @default(0)
  isDemoData       Boolean @default(true)
  createdAt        DateTime @default(now())

  @@unique([academicYear, instituteId, programId, departmentId])
}

model PlacementReport {
  id           String   @id @default(cuid())
  title        String
  academicYear String
  instituteId  String?
  programId    String?
  fileUrl      String?
  summary      String?
  publishedAt  DateTime @default(now())
}

model PlacementPolicy {
  id        String   @id @default(cuid())
  section   String   @unique
  content   String
  updatedAt DateTime @updatedAt
}

model IndustryTestimonial {
  id          String   @id @default(cuid())
  name        String
  designation String
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  photoUrl    String?
  testimonial String
  instituteOrProgram String?
  givenAt     DateTime @default(now())
  isPublished Boolean  @default(true)
}

model AlumniTestimonial {
  id           String  @id @default(cuid())
  name         String
  batch        String
  program      String
  instituteName String
  organization String
  designation  String
  photoUrl     String?
  testimonial  String
  isPublished  Boolean @default(true)
  createdAt    DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  action      String
  entityType  String
  entityId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
